#!/bin/dash

BINDIR="$(dirname "$0")"
PYTHON="$("${BINDIR}/find-myenc-python")" || exit 1

ASCPATH="${1}"
TXTPATH="${ASCPATH%.asc}.txt"

if [ "${ASCPATH}.txt" = "${TXTPATH}" ] ; then
	echo "Invalid file name: $ASCPATH" 1>&2
	exit 1
fi

printf '%s' "Passphrase: " 1>&2
stty -echo 2>/dev/null
read -r PASSPHRASE
stty echo 2>/dev/null
echo 1>&2

if ! "${PYTHON}" -m myenc decred -p "${PASSPHRASE}" -o "${TXTPATH}" "${ASCPATH}" ; then
	echo "Failed to decrypt ${ASCPATH} -> ${TXTPATH}" 1>&2
	exit 1
fi

rm -f "${ASCPATH}"
